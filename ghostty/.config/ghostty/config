# Ghostty — retro gruvbox-material, square, no chrome (ported from alacritty)
theme = gruvbox-material
# The rice shell's theme (colours + ANSI), written by theme-apply.py; optional (?)
# so a fresh install without it still starts. Reloads on SIGUSR2.
config-file = ?~/.local/state/rice/theme/ghostty
# Its own GTK bits (clipboard toast, resize + link overlays) styled like the
# shell's panels; same generator.
gtk-custom-css = ?~/.local/state/rice/theme/ghostty-gtk.css
# Theme switches reload the config in every window; skip that toast, keep
# the clipboard one. (`app-notifications = true` brings both back.)
app-notifications = clipboard-copy,no-config-reload

font-family = DepartureMonoNerdFontMono
font-size = 14

# Hyprland tiles it; no GTK header bar or rounded CSD
window-decoration = none
gtk-titlebar = false
window-padding-x = 4
window-padding-y = 4
confirm-close-surface = false
cursor-style-blink = false
mouse-hide-while-typing = true

# bytes, not lines (~100k lines)
scrollback-limit = 50000000

# Shift+Enter sends ESC CR (newline in claude / nvim prompts), as in alacritty
keybind = shift+enter=text:\x1b\r
