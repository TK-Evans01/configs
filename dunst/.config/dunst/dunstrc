[global]
    monitor = 0
    follow = mouse
    width = 480
    height = (0, 320)
    origin = top-right
    offset = (24, 60)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 12
    progress_bar_frame_width = 1
    progress_bar_min_width = 200
    progress_bar_max_width = 420

    indicate_hidden = yes
    transparency = 10
    separator_height = 3
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 0
    frame_width = 3
    frame_color = "#d4be98"
    gap_size = 6
    separator_color = frame
    sort = yes

    font = DepartureMono Nerd Font Mono 14
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 40
    max_icon_size = 80

    sticky_history = yes
    history_length = 50

    dmenu = /usr/bin/tofi -p 'dunst:'
    browser = /usr/bin/firefox
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#282828"
    foreground = "#a89984"
    frame_color = "#45403d"
    timeout = 5

[urgency_normal]
    background = "#282828"
    foreground = "#d4be98"
    frame_color = "#d4be98"
    timeout = 8

[urgency_critical]
    background = "#282828"
    foreground = "#ea6962"
    frame_color = "#ea6962"
    timeout = 0

[play-sound]
    summary = "*"
    script = /home/tk/.config/dunst/play-sound.sh
